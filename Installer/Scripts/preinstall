#!/bin/sh
set -eu
# Test package: fixed application files only; no user profiles are touched.
if [ "$(/usr/bin/id -u)" != 0 ]; then
    echo 'Administrator authorization is required.' >&2
    exit 1
fi
if [ "$(/usr/bin/uname -m)" != x86_64 ] ||
   ! /usr/bin/sw_vers -productVersion | /usr/bin/awk -F. '
      NF >= 2 && NF <= 3 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && (NF == 2 || $3 ~ /^[0-9]+$/) {
          if ($1 > 10 || ($1 == 10 && ($2 > 13 || ($2 == 13 && $3 >= 6)))) good=1
      }
      END { exit !good }'; then
    echo 'LegacyWG requires an Intel Mac with macOS 10.13.6 or later.' >&2
    exit 1
fi
if [ "${3:-}" != / ]; then
    echo 'This research package supports only the running system volume.' >&2
    exit 1
fi
if [ -e '/Applications/LegacyWG.app' ] || [ -L '/Applications/LegacyWG.app' ] ||
   [ -e '/Library/Application Support/LegacyWG' ] || [ -L '/Library/Application Support/LegacyWG' ] ||
   [ -e '/Library/PrivilegedHelperTools/org.legacywg.helper' ] || [ -L '/Library/PrivilegedHelperTools/org.legacywg.helper' ] ||
   [ -e '/Library/LaunchDaemons/org.legacywg.helper.plist' ] || [ -L '/Library/LaunchDaemons/org.legacywg.helper.plist' ]; then
    echo 'Existing LegacyWG component found. This research package does not perform upgrades.' >&2
    exit 1
fi
script_dir=$(/usr/bin/dirname "$0")
if ! /usr/bin/codesign --verify --strict "$script_dir/legacywg-preflight" >/dev/null 2>&1 ||
   ! "$script_dir/legacywg-preflight" --platform-check; then
    echo 'The VPN engine cannot run on this Mac. No LegacyWG components have been installed.' >&2
    exit 1
fi
exit 0
